; Engine configuration file.
; Lagos Street Racing — Godot 4 project.
; Pinned to Godot 4.4.x. Verify API against this minor version before edits.

config_version=5

[application]

config/name="Lagos Street Racing"
config/description="Street-driving and racing game set on Third Mainland Bridge, Lagos."
run/main_scene="res://scenes/ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Updater="*res://scripts/game/updater.gd"
Game="*res://scripts/game/game_state.gd"
SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"

[debug]

gdscript/warnings/unassigned_variable=1
gdscript/warnings/unused_variable=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

