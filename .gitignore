# Godot 4 project ignores
.godot/
*.tmp

# Exported builds
export/
build/
*.exe
*.pck
*.zip

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Map pipeline: keep config + the final chunk in data/map, not raw/intermediates
tools/lagos_map_pipeline/raw/
tools/lagos_map_pipeline/work/
*.osm.pbf
*.osm
# Python
__pycache__/
*.pyc
.venv/

# in-game update key: written by the build workflows from a secret, never committed
update_token.txt

# GTA III model source is >100 MB: the game loads the compressed libertycity_scene.scn
assets/maps/libertycity/libertycity.glb
assets/maps/libertycity/libertycity.glb.import
